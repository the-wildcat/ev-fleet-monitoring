# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | production | testing
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Defaults to a SQLite file in instance/ when unset.
# Production example: postgresql+psycopg://user:pass@host:5432/ev_fleet
DATABASE_URL=

LOG_LEVEL=INFO

# Timezone used to display times (stored in UTC)
APP_TIMEZONE=Asia/Kolkata

# --- Telemetry ------------------------------------------------------------------------------
# Built-in simulator for vehicles without a real device. Set to false to run it separately
# with `flask simulate`, or to disable it.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5
# 12 = each 5-second tick simulates 1 minute of driving (visible changes during a demo)
SIMULATOR_TIME_SCALE=12
TELEMETRY_RETENTION_DAYS=7

# --- Email (verification + password reset) ---------------------------------------------
# Leave MAIL_SERVER empty to print emails (and their links) in the terminal instead.
# Gmail: turn on 2-Step Verification, create an App Password (Google Account → Security →
# App passwords) and use it as MAIL_PASSWORD. Never use your normal Gmail password.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=EV Fleet Monitor <no-reply@localhost>
