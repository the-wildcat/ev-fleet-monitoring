# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | production | testing
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Defaults to a SQLite file in instance/ when unset.
# Production example: postgresql+psycopg://user:pass@host:5432/ev_fleet
DATABASE_URL=

LOG_LEVEL=INFO

# --- Email (verification + password reset) ---------------------------------------------
# Leave MAIL_SERVER empty to print emails (and their links) in the terminal instead.
# Gmail: turn on 2-Step Verification, create an App Password (Google Account → Security →
# App passwords) and use it as MAIL_PASSWORD. Never use your normal Gmail password.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=EV Fleet Monitor <no-reply@localhost>
